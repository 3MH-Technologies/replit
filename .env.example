# HostBot — انسخ هذا الملف إلى .env ثم عدّل القيم
ADMIN_USER=admin
ADMIN_PASS=change-me-to-a-strong-password
SECRET_KEY=change-me-to-a-long-random-string
PORT=7860
SESSION_COOKIE_SECURE=false
# اجعلها true فقط إذا كنت خلف reverse proxy موثوق (Nginx/Caddy)
TRUST_PROXY=false

# حدود الرفع وفك الضغط
MAX_UPLOAD_MB=200
MAX_EXTRACT_MB=500
MAX_ZIP_ENTRIES=3000

# الاستمرارية والموارد
MONITOR_INTERVAL=15
STABLE_SECONDS=120
RESTART_DELAY_BASE=3
RESTART_DELAY_MAX=60
MAX_BOT_MEM_MB=0
BOT_NICE=10

# اجعلها 1 لإظهار سجلات المكتبات في الكونسول
SHOW_LIB_LOGS=0

# نبضة حياة اختيارية
KEEPALIVE_URL=
KEEPALIVE_INTERVAL=240
